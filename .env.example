# ==============================================================================
# SN - LEITURAS (RESIDENCIAL CAMPOS DO SUL) — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# O aplicativo funciona 100% offline no modo "Piloto Local" mesmo sem estas
# variáveis. Para habilitar o Teste em Dupla com Firebase (Login Google +
# Sincronização Incremental no Firestore padrão), preencha as credenciais do
# projeto Firebase piloto abaixo (ou na Vercel em Settings -> Environment Variables):

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Banco Firestore padrão do projeto piloto. Use "(default)" para o banco padrão:
VITE_FIREBASE_DATABASE_ID="(default)"

# Lista opcional de UIDs autorizados (para exibição de diagnóstico na interface;
# o bloqueio real de segurança é feito diretamente no arquivo firestore.rules):
VITE_AUTHORIZED_UID_1="UID_LEITURISTA_1"
VITE_AUTHORIZED_UID_2="UID_LEITURISTA_2"
