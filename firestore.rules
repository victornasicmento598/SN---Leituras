rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Lista fixa de dois UIDs autorizados para coleta em dupla no Residencial Campos do Sul.
    // 1º Leiturista: Gs87xj1DKRg0RrnOXVnCuZAEeW63 (nascifeupa@gmail.com)
    // Substitua 'UID_LEITURISTA_2' pelo UID do segundo aparelho no painel Firebase Authentication.
    function isAuthorizedReader() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (request.auth.uid in ['Gs87xj1DKRg0RrnOXVnCuZAEeW63', 'UID_LEITURISTA_2']);
    }

    // 3. Validation Blueprints
    function isValidCycleSettings(data) {
      return data.keys().hasAll([
          'condominiumId', 'cycleId', 'waterAlertLimit', 'waterCeilingLimit',
          'gasAlertLimit', 'gasCeilingLimit', 'gasNoiseLimit',
          'waterTariffPerM3', 'hasWaterTariff', 'gasTariffPerM3', 'hasGasTariff',
          'physicalOrders', 'revision', 'revisionToken', 'baseRevisionToken',
          'updatedByUid', 'updatedByName', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'condominiumId', 'cycleId', 'waterAlertLimit', 'waterCeilingLimit',
          'gasAlertLimit', 'gasCeilingLimit', 'gasNoiseLimit',
          'waterTariffPerM3', 'hasWaterTariff', 'gasTariffPerM3', 'hasGasTariff',
          'physicalOrders', 'revision', 'revisionToken', 'baseRevisionToken',
          'updatedByUid', 'updatedByName', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.condominiumId is string && data.condominiumId == 'campos-do-sul' && data.condominiumId.size() == 13
        && data.cycleId is string && data.cycleId.size() == 7 && data.cycleId.matches('^[0-9]{4}-[0-9]{2}$')
        && data.waterAlertLimit is number && data.waterAlertLimit > 0 && data.waterAlertLimit <= 1000
        && data.waterCeilingLimit is number && data.waterCeilingLimit >= data.waterAlertLimit && data.waterCeilingLimit <= 10000
        && data.gasAlertLimit is number && data.gasAlertLimit > 0 && data.gasAlertLimit <= 1000
        && data.gasCeilingLimit is number && data.gasCeilingLimit >= data.gasAlertLimit && data.gasCeilingLimit <= 10000
        && data.gasNoiseLimit is number && data.gasNoiseLimit >= 0 && data.gasNoiseLimit <= 50
        && data.waterTariffPerM3 is number && data.waterTariffPerM3 >= -1 && data.waterTariffPerM3 <= 10000
        && data.hasWaterTariff is bool
        && data.gasTariffPerM3 is number && data.gasTariffPerM3 >= -1 && data.gasTariffPerM3 <= 10000
        && data.hasGasTariff is bool
        && data.physicalOrders is map && data.physicalOrders.size() <= 28
        && data.revision is int && data.revision >= 1
        && data.revisionToken is string && data.revisionToken.size() >= 8 && data.revisionToken.size() <= 64
        && data.baseRevisionToken is string && data.baseRevisionToken.size() <= 64
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40
        && data.serverUpdatedAt == request.time;
    }

    function isValidTowerReference(data) {
      return data.keys().hasAll([
          'condominiumId', 'cycleId', 'service', 'tower', 'apartments', 'sourceFile',
          'revision', 'revisionToken', 'baseRevisionToken',
          'importedByUid', 'importedByName', 'importedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'condominiumId', 'cycleId', 'service', 'tower', 'apartments', 'sourceFile',
          'revision', 'revisionToken', 'baseRevisionToken',
          'importedByUid', 'importedByName', 'importedAt', 'serverUpdatedAt'
        ])
        && data.condominiumId is string && data.condominiumId == 'campos-do-sul' && data.condominiumId.size() == 13
        && data.cycleId is string && data.cycleId.size() == 7 && data.cycleId.matches('^[0-9]{4}-[0-9]{2}$')
        && data['service'] is string && (data['service'] == 'water' || data['service'] == 'gas') && data['service'].size() <= 5
        && data.tower is int && data.tower >= 1 && data.tower <= 28
        && data.apartments is map && data.apartments.size() <= 20
        && data.sourceFile is string && data.sourceFile.size() >= 1 && data.sourceFile.size() <= 160
        && data.revision is int && data.revision >= 1
        && data.revisionToken is string && data.revisionToken.size() >= 8 && data.revisionToken.size() <= 64
        && data.baseRevisionToken is string && data.baseRevisionToken.size() <= 64
        && data.importedByUid is string && data.importedByUid.size() >= 1 && data.importedByUid.size() <= 128
        && data.importedByUid == request.auth.uid
        && data.importedByName is string && data.importedByName.size() >= 1 && data.importedByName.size() <= 120
        && data.importedAt is string && data.importedAt.size() >= 10 && data.importedAt.size() <= 40
        && data.serverUpdatedAt == request.time;
    }

    function isValidMeterReading(data) {
      return data.keys().hasAll([
          'id', 'condominiumId', 'cycleId', 'service', 'tower', 'apartment',
          'previousValue', 'hasPreviousValue', 'currentValue', 'consumption', 'hasConsumption',
          'appliedTariff', 'hasAppliedTariff', 'calculatedAmountBrl', 'hasCalculatedAmountBrl', 'amountUnavailableReason',
          'referenceSource', 'status', 'alerts', 'exceptionType', 'observation',
          'auditCode1', 'auditCode2', 'photo1DataUrl', 'photo2DataUrl',
          'revision', 'revisionToken', 'baseRevisionToken',
          'createdByUid', 'createdByName', 'createdAt',
          'updatedByUid', 'updatedByName', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'condominiumId', 'cycleId', 'service', 'tower', 'apartment',
          'previousValue', 'hasPreviousValue', 'currentValue', 'consumption', 'hasConsumption',
          'appliedTariff', 'hasAppliedTariff', 'calculatedAmountBrl', 'hasCalculatedAmountBrl', 'amountUnavailableReason',
          'referenceSource', 'status', 'alerts', 'exceptionType', 'observation',
          'auditCode1', 'auditCode2', 'photo1DataUrl', 'photo2DataUrl',
          'revision', 'revisionToken', 'baseRevisionToken',
          'createdByUid', 'createdByName', 'createdAt',
          'updatedByUid', 'updatedByName', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.id is string && data.id.size() >= 10 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.condominiumId is string && data.condominiumId == 'campos-do-sul' && data.condominiumId.size() == 13
        && data.cycleId is string && data.cycleId.size() == 7 && data.cycleId.matches('^[0-9]{4}-[0-9]{2}$')
        && data['service'] is string && (data['service'] == 'water' || data['service'] == 'gas') && data['service'].size() <= 5
        && data.tower is int && data.tower >= 1 && data.tower <= 28
        && data.apartment is string && data.apartment.size() == 3 && data.apartment.matches('^[1-5]0[1-4]$')
        && data.previousValue is number && data.previousValue >= -1 && data.previousValue <= 9999999
        && data.hasPreviousValue is bool
        && data.currentValue is number && data.currentValue >= 0 && data.currentValue <= 9999999
        && data.consumption is number && data.consumption >= -9999999 && data.consumption <= 9999999
        && data.hasConsumption is bool
        && data.appliedTariff is number && data.appliedTariff >= -1 && data.appliedTariff <= 10000
        && data.hasAppliedTariff is bool
        && data.calculatedAmountBrl is number && data.calculatedAmountBrl >= -1 && data.calculatedAmountBrl <= 9999999
        && data.hasCalculatedAmountBrl is bool
        && data.amountUnavailableReason is string && data.amountUnavailableReason.size() <= 120
        && data.referenceSource is string && (data.referenceSource == 'configured_limits' || data.referenceSource == 'historical') && data.referenceSource.size() <= 20
        && data.status is string && (data.status == 'read' || data.status == 'alert') && data.status.size() <= 10
        && data.alerts is string && data.alerts.size() <= 160
        && data.exceptionType is string && (data.exceptionType in ['none', 'confirmed_high', 'confirmed_negative', 'meter_replaced']) && data.exceptionType.size() <= 24
        && data.observation is string && data.observation.size() <= 500
        && data.auditCode1 is string && data.auditCode1.size() <= 64
        && data.auditCode2 is string && data.auditCode2.size() <= 64
        && data.photo1DataUrl is string && data.photo1DataUrl.size() <= 380000
        && data.photo2DataUrl is string && data.photo2DataUrl.size() <= 380000
        && data.revision is int && data.revision >= 1
        && data.revisionToken is string && data.revisionToken.size() >= 8 && data.revisionToken.size() <= 64
        && data.baseRevisionToken is string && data.baseRevisionToken.size() <= 64
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40
        && data.serverUpdatedAt == request.time;
    }

    // 4. Collection Rules: Cycle Settings
    match /cycles/{cycleId}/settings/{docId} {
      allow get: if isAuthorizedReader() && isValidId(cycleId) && isValidId(docId);
      allow list: if isAuthorizedReader();
      allow create: if isAuthorizedReader()
        && isValidId(cycleId)
        && isValidId(docId)
        && isValidCycleSettings(incoming())
        && incoming().cycleId == cycleId
        && incoming().revision == 1
        && incoming().baseRevisionToken == "";
      allow update: if isAuthorizedReader()
        && isValidId(cycleId)
        && isValidId(docId)
        && isValidCycleSettings(incoming())
        && incoming().condominiumId == existing().condominiumId
        && incoming().cycleId == existing().cycleId
        && incoming().revision == existing().revision + 1
        && incoming().baseRevisionToken == existing().revisionToken
        && incoming().revisionToken != existing().revisionToken
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'waterAlertLimit', 'waterCeilingLimit', 'gasAlertLimit', 'gasCeilingLimit',
          'gasNoiseLimit', 'waterTariffPerM3', 'hasWaterTariff', 'gasTariffPerM3', 'hasGasTariff',
          'physicalOrders', 'revision', 'revisionToken', 'baseRevisionToken',
          'updatedByUid', 'updatedByName', 'updatedAt', 'serverUpdatedAt'
        ]);
      allow delete: if false;
    }

    // 5. Collection Rules: Tower References (CSV Imports & Re-imports)
    match /cycles/{cycleId}/references/{docId} {
      allow get: if isAuthorizedReader() && isValidId(cycleId) && isValidId(docId);
      allow list: if isAuthorizedReader();
      allow create: if isAuthorizedReader()
        && isValidId(cycleId)
        && isValidId(docId)
        && isValidTowerReference(incoming())
        && incoming().cycleId == cycleId
        && incoming().revision == 1
        && incoming().baseRevisionToken == "";
      allow update: if isAuthorizedReader()
        && isValidId(cycleId)
        && isValidId(docId)
        && isValidTowerReference(incoming())
        && incoming().condominiumId == existing().condominiumId
        && incoming().cycleId == existing().cycleId
        && incoming()['service'] == existing()['service']
        && incoming().tower == existing().tower
        && incoming().revision == existing().revision + 1
        && incoming().baseRevisionToken == existing().revisionToken
        && incoming().revisionToken != existing().revisionToken
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'apartments', 'sourceFile', 'revision', 'revisionToken', 'baseRevisionToken',
          'importedByUid', 'importedByName', 'importedAt', 'serverUpdatedAt'
        ]);
      allow delete: if false;
    }

    // 6. Collection Rules: Meter Readings (Água & Gás)
    match /cycles/{cycleId}/readings/{docId} {
      allow get: if isAuthorizedReader() && isValidId(cycleId) && isValidId(docId);
      allow list: if isAuthorizedReader();
      allow create: if isAuthorizedReader()
        && isValidId(cycleId)
        && isValidId(docId)
        && isValidMeterReading(incoming())
        && incoming().id == docId
        && incoming().cycleId == cycleId
        && incoming().createdByUid == request.auth.uid
        && incoming().revision == 1
        && incoming().baseRevisionToken == "";
      allow update: if isAuthorizedReader()
        && isValidId(cycleId)
        && isValidId(docId)
        && isValidMeterReading(incoming())
        && incoming().id == existing().id
        && incoming().condominiumId == existing().condominiumId
        && incoming().cycleId == existing().cycleId
        && incoming()['service'] == existing()['service']
        && incoming().tower == existing().tower
        && incoming().apartment == existing().apartment
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().revision == existing().revision + 1
        && incoming().baseRevisionToken == existing().revisionToken
        && incoming().revisionToken != existing().revisionToken
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'previousValue', 'hasPreviousValue', 'currentValue', 'consumption', 'hasConsumption',
          'appliedTariff', 'hasAppliedTariff', 'calculatedAmountBrl', 'hasCalculatedAmountBrl', 'amountUnavailableReason',
          'referenceSource', 'status', 'alerts', 'exceptionType', 'observation',
          'auditCode1', 'auditCode2', 'photo1DataUrl', 'photo2DataUrl',
          'revision', 'revisionToken', 'baseRevisionToken',
          'updatedByUid', 'updatedByName', 'updatedAt', 'serverUpdatedAt'
        ]);
      allow delete: if false;
    }
  }
}
